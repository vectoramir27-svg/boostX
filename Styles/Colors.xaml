<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Черно-белая премиум палитра -->
    <Color x:Key="PureBlackColor">#0A0A0A</Color>
    <Color x:Key="SidebarBgColor">#111111</Color>
    <Color x:Key="CardBgColor">#151515</Color>
    <Color x:Key="CardHoverColor">#1C1C1C</Color>
    <Color x:Key="BorderDarkColor">#242424</Color>
    
    <Color x:Key="PureWhiteColor">#FFFFFF</Color>
    <Color x:Key="TextMutedColor">#888888</Color>
    <Color x:Key="SwitchTrackOffColor">#2A2A2A</Color>

    <SolidColorBrush x:Key="PureBlackBrush" Color="{StaticResource PureBlackColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}"/>
    
    <SolidColorBrush x:Key="PureWhiteBrush" Color="{StaticResource PureWhiteColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="{StaticResource SwitchTrackOffColor}"/>
</ResourceDictionary>