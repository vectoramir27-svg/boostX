<Window x:Class="BoostX.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BoostX.ViewModels"
        Title="boostX" Height="740" Width="1120"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        WindowStyle="None" AllowsTransparency="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border CornerRadius="20" BorderBrush="#33FFFFFF" BorderThickness="1" Background="#060606" ClipToBounds="True">
        <Grid>
            <!-- Фоновые источники света (Ambient Glow) -->
            <Canvas IsHitTestVisible="False">
                <Ellipse Width="450" Height="450" Canvas.Right="-100" Canvas.Top="-150" Opacity="0.07">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="550" Height="400" Canvas.Left="300" Canvas.Bottom="-150" Opacity="0.04">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- Основная сетка -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarCol" Width="260" MinWidth="72" MaxWidth="340"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= 1. ЛЕВАЯ ПАНЕЛЬ ================= -->
                <Border Grid.Column="0" Background="#08FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" SizeChanged="SidebarBorder_SizeChanged" ClipToBounds="True">
                    <Grid Margin="12,18,12,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Шапка логотипа -->
                        <Grid Grid.Row="0" Margin="0,4,0,28" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFFFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <Path Data="M13,2 L4,14 L11,14 L10,22 L20,9 L13,9 Z" Fill="#000000" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel x:Name="LogoTextContainer" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Text="boost" FontSize="19" FontWeight="Bold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                <TextBlock Text="X" FontSize="21" FontWeight="Black" Foreground="#FFFFFF" Margin="1,0,0,0" VerticalAlignment="Center"/>
                                
                                <Button x:Name="BtnChangelog" Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnChangelog_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="v1.0.0" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#25FFFFFF"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#50FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Меню навигации с иконками -->
                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavPrivacy" IsChecked="True" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M12,1 L3,5 L3,11 C3,16.5 6.8,21.7 12,23 C17.2,21.7 21,16.5 21,11 L21,5 L12,1 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtNav1" Text="Приватность" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavPerformance" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtNav2" Text="Производительность" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavSecurity" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M18,8 L17,8 L17,6 C17,3.2 14.8,1 12,1 C9.2,1 7,3.2 7,6 L7,8 L6,8 C4.9,8 4,8.9 4,10 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,10 C20,8.9 19.1,8 18,8 Z M9,6 C9,4.3 10.3,3 12,3 C13.7,3 15,4.3 15,6 L15,8 L9,8 L9,6 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtNav3" Text="Безопасность" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavServices" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M19.14,12.94 C19.18,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.37 19.14,11.06 L21.16,9.48 C21.34,9.34 21.39,9.08 21.28,8.88 L19.36,5.55 C19.24,5.34 19,5.26 18.78,5.34 L16.4,6.3 C15.9,5.92 15.37,5.6 14.79,5.36 L14.43,2.83 C14.39,2.6 14.2,2.42 13.96,2.42 L10.04,2.42 C9.8,2.42 9.61,2.6 9.57,2.83 L9.21,5.36 C8.63,5.6 8.1,5.92 7.6,6.3 L5.22,5.34 C5,5.26 4.76,5.34 4.64,5.55 L2.72,8.88 C2.61,9.08 2.66,9.34 2.84,9.48 L4.86,11.06 C4.82,11.37 4.8,11.68 4.8,12 C4.8,12.32 4.82,12.63 4.86,12.94 L2.84,14.52 C2.66,14.66 2.61,14.92 2.72,15.12 L4.64,18.45 C4.76,18.66 5,18.74 5.22,18.66 L7.6,17.7 C8.1,18.08 8.63,18.4 9.21,18.64 L9.57,21.17 C9.61,21.4 9.8,21.58 10.04,21.58 L13.96,21.58 C14.2,21.58 14.39,21.4 14.43,21.17 L14.79,18.64 C15.37,18.4 15.9,18.08 16.4,17.7 L18.78,18.66 C19,18.74 19.24,18.66 19.36,18.45 L21.28,15.12 C21.39,14.92 21.34,14.66 21.16,14.52 L19.14,12.94 Z M12,15.5 C10.07,15.5 8.5,13.93 8.5,12 C8.5,10.07 10.07,8.5 12,8.5 C13.93,8.5 15.5,10.07 15.5,12 C15.5,13.93 13.93,15.5 12,15.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtNav4" Text="Службы и апдейты" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavApps" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M4,8 L8,8 L8,4 L4,4 L4,8 Z M10,20 L14,20 L14,16 L10,16 L10,20 Z M4,20 L8,20 L8,16 L4,16 L4,20 Z M4,14 L8,14 L8,10 L4,10 L4,14 Z M10,14 L14,14 L14,10 L10,10 L10,14 Z M16,4 L16,8 L20,8 L20,4 L16,4 Z M10,8 L14,8 L14,4 L10,4 L10,8 Z M16,14 L20,14 L20,10 L16,10 L16,14 Z M16,20 L20,20 L20,16 L16,16 L16,20 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtNav5" Text="Удаление софта &amp; AI" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavCleaner" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M19.36,2.72 L20.78,4.14 L15.06,9.85 C16.3,11.41 16.08,13.68 14.54,15.22 C13.76,16 12.74,16.4 11.71,16.4 C11.36,16.4 11.02,16.35 10.68,16.24 L8.55,18.37 C9.07,19.5 8.81,20.91 7.78,21.94 C6.61,23.11 4.71,23.11 3.54,21.94 C2.37,20.77 2.37,18.87 3.54,17.7 C4.57,16.67 5.98,16.41 7.11,16.93 L9.24,14.8 C8.74,13.34 9.05,11.66 10.22,10.5 C11.76,8.96 14.03,8.74 15.59,9.98 L19.36,2.72 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtNav6" Text="Глубокая очистка" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!-- Автор и канал -->
                        <Border x:Name="AdminBadge" Grid.Row="2" Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="DEVELOPER &amp; TECH" Foreground="#888888" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Cursor="Hand" Margin="0,3,0,0" MouseLeftButtonDown="TelegramLink_Click">
                                    <Run Text="by " Foreground="#666666" FontSize="11"/>
                                    <Run Text="@wonderfultech" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" TextDecorations="Underline"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= 2. РАЗДЕЛИТЕЛЬ ================= -->
                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE" ShowsPreview="False">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" Width="8">
                                <Grid HorizontalAlignment="Center">
                                    <Rectangle Width="1" Fill="#15FFFFFF"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Ellipse Width="3" Height="3" Fill="#555555" Margin="0,2"/>
                                        <Ellipse Width="3" Height="3" Fill="#555555" Margin="0,2"/>
                                        <Ellipse Width="3" Height="3" Fill="#555555" Margin="0,2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- ================= 3. ПРАВАЯ ОБЛАСТЬ ================= -->
                <Grid Grid.Column="2" Margin="24,20,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Верхний бар -->
                    <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource WindowControlBtn}" Margin="0,0,8,0" Click="BtnSettings_Click">
                                <Path Data="M19.14,12.94 C19.18,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.37 19.14,11.06 L21.16,9.48 C21.34,9.34 21.39,9.08 21.28,8.88 L19.36,5.55 C19.24,5.34 19,5.26 18.78,5.34 L16.4,6.3 C15.9,5.92 15.37,5.6 14.79,5.36 L14.43,2.83 C14.39,2.6 14.2,2.42 13.96,2.42 L10.04,2.42 C9.8,2.42 9.61,2.6 9.57,2.83 L9.21,5.36 C8.63,5.6 8.1,5.92 7.6,6.3 L5.22,5.34 C5,5.26 4.76,5.34 4.64,5.55 L2.72,8.88 C2.61,9.08 2.66,9.34 2.84,9.48 L4.86,11.06 C4.82,11.37 4.8,11.68 4.8,12 C4.8,12.32 4.82,12.63 4.86,12.94 L2.84,14.52 C2.66,14.66 2.61,14.92 2.72,15.12 L4.64,18.45 C4.76,18.66 5,18.74 5.22,18.66 L7.6,17.7 C8.1,18.08 8.63,18.4 9.21,18.64 L9.57,21.17 C9.61,21.4 9.8,21.58 10.04,21.58 L13.96,21.58 C14.2,21.58 14.39,21.4 14.43,21.17 L14.79,18.64 C15.37,18.4 15.9,18.08 16.4,17.7 L18.78,18.66 C19,18.74 19.24,18.66 19.36,18.45 L21.28,15.12 C21.39,14.92 21.34,14.66 21.16,14.52 L19.14,12.94 Z M12,15.5 C10.07,15.5 8.5,13.93 8.5,12 C8.5,10.07 10.07,8.5 12,8.5 C13.93,8.5 15.5,10.07 15.5,12 C15.5,13.93 13.93,15.5 12,15.5 Z" Fill="#AAAAAA" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>
                            <Button Style="{StaticResource WindowControlBtn}" Margin="0,0,6,0" Click="BtnMinimize_Click">
                                <Path Data="M0,5 L10,5" Stroke="#AAAAAA" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource WindowCloseBtn}" Click="BtnClose_Click">
                                <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#AAAAAA" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Мониторинг ПК -->
                    <Border Grid.Row="1" Style="{StaticResource GlassMonitorCard}" Padding="18,14" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ПРОЦЕССОР" Foreground="#777777" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CpuName}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="ВИДЕОКАРТА" Foreground="#777777" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding GpuName}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="ПАМЯТЬ RAM" Foreground="#777777" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding RamUsage}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="12,0,0,0">
                                <TextBlock Text="ДИСК C:" Foreground="#777777" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DiskSpace}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Страницы твиков -->
                    <Grid Grid.Row="2" x:Name="PageContentContainer">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PageTranslateTransform" Y="0"/>
                        </Grid.RenderTransform>

                        <ScrollViewer x:Name="TweaksScrollViewer" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="TweaksItemsControl" ItemsSource="{Binding PrivacyTweaksList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BlackCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="#888888" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{StaticResource BlackToggleSwitch}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Панель софта -->
                        <StackPanel x:Name="AppsPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource BlackCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Удалить Microsoft OneDrive" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Деинсталляция и блокировка повторной фоновой установки" Foreground="#888888" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Удалить" Style="{StaticResource WhiteButton}" Click="BtnRemoveOneDrive_Click"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource BlackCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Удалить UWP-приложения" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Очистка встроенных сервисов (Карты, Погода, Zune, Solitaire)" Foreground="#888888" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Очистить" Style="{StaticResource WhiteButton}" Click="BtnRemoveUwp_Click"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource BlackCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Отключить Copilot, Recall и Cortana" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Полная деактивация встроенных AI-ассистентов и снимков экрана" Foreground="#888888" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Отключить" Style="{StaticResource WhiteButton}" Click="BtnDisableAi_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Панель очистки -->
                        <StackPanel x:Name="CleanerPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource BlackCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Очистить оперативную память (RAM)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Сброс неиспользуемых рабочих наборов всех запущенных процессов" Foreground="#888888" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Очистить RAM" Style="{StaticResource WhiteButton}" Click="BtnFlushRam_Click"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource BlackCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Удалить временные файлы (Temp &amp; Prefetch)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Очистка системных кэшей и временных файлов приложений" Foreground="#888888" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Очистить Temp" Style="{StaticResource WhiteButton}" Click="BtnCleanTemp_Click"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource BlackCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Очистить кэш обновлений Windows" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Очищает директорию SoftwareDistribution\Download" Foreground="#888888" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Очистить кэш" Style="{StaticResource WhiteButton}" Click="BtnCleanUpdates_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= 4. МОДАЛЬНОЕ ОКНО «ЧТО НОВОГО» ================= -->
                <Grid x:Name="ChangelogModal" Grid.ColumnSpan="3" Visibility="Collapsed" Opacity="0" Background="#CC000000">
                    <Border Width="580" MaxHeight="620" Background="#141414" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="20" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Что нового в boostX" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource WindowControlBtn}" HorizontalAlignment="Right" Click="BtnCloseChangelog_Click">
                                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#AAAAAA" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" MaxHeight="440">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,24">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Background="#0D47A1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="v1.0.0" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="25 августа 2026" Foreground="#777777" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• Авторизация через единый профиль BoostX ID" Foreground="#CCCCCC" FontSize="13" Margin="4,2,0,4"/>
                                        <TextBlock Text="• Синхронизация пресетов в облако и экспорт в файл .boostx" Foreground="#CCCCCC" FontSize="13" Margin="4,2,0,4"/>
                                        <TextBlock Text="• Выбор неоновых тем (Apple Green, Blue, Purple, Orange, White)" Foreground="#CCCCCC" FontSize="13" Margin="4,2,0,4"/>
                                        <TextBlock Text="• Встроенный фоновый модуль бесшовного онлайн-автоапдейта" Foreground="#CCCCCC" FontSize="13" Margin="4,2,0,4"/>
                                        <TextBlock Text="• Полная поддержка двустороннего отката (Undo) для всех твиков" Foreground="#CCCCCC" FontSize="13" Margin="4,2,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="#0CFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,18,0,0">
                                <Grid>
                                    <TextBlock Text="Официальный канал проекта:" Foreground="#777777" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="TelegramLink_Click">
                                        <Run Text="t.me/wonderfultech" Foreground="#34C759" FontWeight="Bold" FontSize="12" TextDecorations="Underline"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= 5. МОДАЛЬНОЕ ОКНО НАСТРОЕК & BOOSTX ID ================= -->
                <Grid x:Name="SettingsModal" Grid.ColumnSpan="3" Visibility="Collapsed" Opacity="0" Background="#CC000000">
                    <Border Width="600" Background="#141414" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="20" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <TextBlock Text="Параметры и BoostX ID" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource WindowControlBtn}" HorizontalAlignment="Right" Click="BtnCloseSettings_Click">
                                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#AAAAAA" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <!-- 1. Авторизация BoostX ID -->
                            <TextBlock Text="АВТОРИЗАЦИЯ BOOSTX ID" Foreground="#777777" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtBoostXKey" Grid.Column="0" Style="{StaticResource GlassTextBox}" Margin="0,0,8,0" Tag="BX-XXXX-XXXX-XXXX"/>
                                        <Button Grid.Column="1" Content="Войти" Style="{StaticResource WhiteButton}" Margin="0,0,8,0" Click="BtnLoginKey_Click"/>
                                        <Button Grid.Column="2" Content="Получить ключ в боте" Style="{StaticResource GlassOutlineButton}" Click="BtnGetBotKey_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtAccountStatus" Text="Сессия: Гостевой режим (Локально)" Foreground="#888888" FontSize="11" Margin="2,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. Выбор цветовой схемы -->
                            <TextBlock Text="АКЦЕНТНЫЙ ЦВЕТ ИНТЕРФЕЙСА" Foreground="#777777" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Width="32" Height="32" Background="#34C759" Margin="0,0,10,0" Tag="#34C759" Click="ColorTheme_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Width="32" Height="32" Background="#0A84FF" Margin="0,0,10,0" Tag="#0A84FF" Click="ColorTheme_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Width="32" Height="32" Background="#AF52DE" Margin="0,0,10,0" Tag="#AF52DE" Click="ColorTheme_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Width="32" Height="32" Background="#FF9F0A" Margin="0,0,10,0" Tag="#FF9F0A" Click="ColorTheme_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Width="32" Height="32" Background="#FFFFFF" Margin="0,0,10,0" Tag="#FFFFFF" Click="ColorTheme_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- 3. Пресеты конфигурации -->
                            <TextBlock Text="УПРАВЛЕНИЕ ПРЕСЕТАМИ КОНФИГУРАЦИИ" Foreground="#777777" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Файл профиля (.boostx)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Сохранить текущие тумблеры или перенести на другой ПК" Foreground="#777777" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Экспорт" Style="{StaticResource GlassOutlineButton}" Margin="0,0,8,0" Click="BtnExportPreset_Click"/>
                                    <Button Grid.Column="2" Content="Импорт" Style="{StaticResource WhiteButton}" Click="BtnImportPreset_Click"/>
                                </Grid>
                            </Border>

                            <!-- 4. Автоапдейтер -->
                            <TextBlock Text="ОБНОВЛЕНИЕ ПРОГРАММЫ" Foreground="#777777" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Онлайн-автоапдейтер" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Текущая сборка: v1.0.0" Foreground="#777777" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Проверить" Style="{StaticResource WhiteButton}" Click="BtnCheckUpdates_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 6. УВЕДОМЛЕНИЯ TOAST ================= -->
                <Border x:Name="ToastNotification" Grid.ColumnSpan="3"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,32" Opacity="0" IsHitTestVisible="False"
                        Background="#1FFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                        CornerRadius="24" Padding="18,10">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.7"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTranslateTransform" Y="25"/>
                    </Border.RenderTransform>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ToastIconBg" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentColorBrush}" Margin="0,0,10,0">
                            <Path x:Name="ToastIconPath" Data="M4,11 L9,16 L18,7" Stroke="#FFFFFF" StrokeThickness="2" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="ToastMessageText" Text="Уведомление" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>